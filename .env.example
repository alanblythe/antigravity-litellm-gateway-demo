# ==============================================================================
# Antigravity + LiteLLM Enterprise Gateway Sandbox Environment
# Usage: cp .env.example .env
# ==============================================================================

# Google Cloud Vertex AI Configuration
# Set this to your GCP project ID where Vertex AI API is enabled
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=us-central1

# LiteLLM Master API Key (Bearer token for client authentication)
LITELLM_MASTER_KEY=sk-enterprise-demo-key

# Host path to Google Cloud Application Default Credentials (ADC) JSON file
# e.g., /home/username/.config/gcloud/application_default_credentials.json (Linux)
# e.g., /Users/username/.config/gcloud/application_default_credentials.json (macOS)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/application_default_credentials.json
